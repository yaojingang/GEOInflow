POSTGRES_USER=liekan
POSTGRES_DB=liekan
POSTGRES_PASSWORD=replace-with-a-random-secret
DATABASE_URL=postgresql://liekan:replace-with-a-random-secret@127.0.0.1:15435/liekan
APP_SECRET=replace-with-a-random-secret
TWO_FACTOR_ENCRYPTION_KEY=replace-with-a-random-secret
DISABLE_TELEMETRY=1
NEXT_TELEMETRY_DISABLED=1
DEFAULT_LOCALE=zh-CN
API_KEY_ENABLED=1

# Geography is prepared automatically from DB-IP City Lite without credentials.
# An existing authorized geo/GeoLite2-City.mmdb takes precedence.
# Optional local preparation with pnpm build:geo; keys stay outside Docker builds.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
GEO_DATABASE_URL=

# Automatic logs: serve the application and receiver through the same HTTPS origin.
LIEKAN_PUBLIC_URL=
# For sh scripts/liekan-deploy.sh --traefik, set the public host only (no scheme or path).
GEOINFLOW_DOMAIN=
LIEKAN_LOG_CREDENTIALS_KEY=
LIEKAN_LOG_PREVIOUS_KEYS=
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=
# Build-time Ed25519 key file, kept outside the repository and container image.
LIEKAN_AGENT_SIGNING_KEY_FILE=

# Optional derived analytics cache; independent from REDIS_URL used by authentication.
LIEKAN_ANALYTICS_REDIS_URL=

# AI is optional. Use a separate random 32-byte hex key before enabling it.
LIEKAN_AI_ENABLED=false
LIEKAN_AI_ENCRYPTION_KEY=
