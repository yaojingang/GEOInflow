# Server-side source build: builds the collector bundles straight from the
# repository source, so a git clone plus Docker is enough on the log server —
# no prebuilt agent.mjs / container.mjs need to be copied over.
#
# Build:   docker compose -f docker-compose.server.yml build
# Up:      docker compose -f docker-compose.server.yml up -d
# China:   docker compose -f docker-compose.server.yml build \
#            --build-arg NPM_REGISTRY=https://registry.npmmirror.com
#
# The bundle step reproduces scripts/liekan-build-agent.mjs exactly (esbuild
# --bundle --platform=node --target=node22 --format=esm on the same two entry
# points); it skips the installer downloads and manifest signing, which the
# manual deployment kit does not use.

# Override for restricted networks, e.g.
#   --build-arg BASE_IMAGE=docker.m.daocloud.io/library/node:22.23.4-alpine
ARG BASE_IMAGE=node:22.23.4-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914
FROM ${BASE_IMAGE} AS build
WORKDIR /src
ARG NPM_REGISTRY=https://registry.npmjs.org
RUN npm config set registry "${NPM_REGISTRY}" \
    && npm install --ignore-scripts esbuild@0.28.2 zod@4.6.7
# Same relative layout as the repository root so esbuild finds tsconfig.json
# the same way it does when liekan:build-agent runs from a checkout.
COPY tsconfig.json ./
COPY src/liekan-agent ./src/liekan-agent
COPY src/lib ./src/lib
RUN ./node_modules/.bin/esbuild src/liekan-agent/main.ts \
        --bundle --platform=node --target=node22 --format=esm --outfile=/out/agent.mjs \
    && ./node_modules/.bin/esbuild src/liekan-agent/container.ts \
        --bundle --platform=node --target=node22 --format=esm --outfile=/out/container.mjs

FROM ${BASE_IMAGE}
WORKDIR /app
COPY --from=build /out/agent.mjs /out/container.mjs ./
COPY LICENSE ./
RUN mkdir -p /var/lib/liekan-agent && chown 65532:65532 /var/lib/liekan-agent \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
USER 65532:65532
ENTRYPOINT ["node", "/app/container.mjs"]
CMD ["run"]
