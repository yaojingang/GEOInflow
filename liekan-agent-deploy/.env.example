# GEOInflow 采集器手动部署配置
# 复制为 .env 后按注释填写：cp .env.example .env

# 统计服务的公网 HTTPS 地址（网站后台"数据接入"页面显示的接收地址，不含结尾斜杠）
LIEKAN_PUBLIC_URL=https://stats.example.com

# 网站标识：网站后台生成配对码时页面会显示（UUID 格式）
LIEKAN_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# 网站访问日志所在目录（宿主机绝对路径，整目录只读挂载进容器）
# 宝塔通常为 /www/wwwlogs；自装 Nginx 通常为 /var/log/nginx（看站点配置 access_log 指令）
LIEKAN_LOG_DIRECTORY=/www/wwwlogs

# 当前网站的访问日志文件名（仅文件名，Nginx / Apache Combined 格式）
LIEKAN_LOG_FILE=www.example.com.log

# 对日志有读权限的用户组 GID（容器以 65532:<该组> 运行，无需修改日志权限）
# 宝塔通常为 www 组：id -g www 查询；自装 Nginx 通常为 adm 组或 nginx 组
LIEKAN_LOG_GID=1001

# 采集器状态目录（长期凭据、加密缓冲、读取位点），相对路径基于本文件夹
# 首次启动前需创建并授权：mkdir -p state && chown 65532:65532 state
LIEKAN_STATE_DIRECTORY=./state

# 一次性配对码（网站后台"数据接入"生成，10 分钟内有效、只能使用一次）
# 仅首次启动需要；配对成功后此码即失效，可从 .env 删除。日常重启、升级无需再填
LIEKAN_PAIRING_CODE=
